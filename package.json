{
  "name": "rote",
  "version": "1.0.0",
  "description": "Discover UI capabilities once with an LLM, then replay them deterministically.",
  "type": "module",
  "main": "dist/cli.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "discover": "tsx src/cli.ts discover",
    "replay": "tsx src/cli.ts replay"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "openai": "^6.49.0",
    "playwright": "^1.62.1",
    "tesseract.js": "^6.0.1",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vitest": "^3.2.6"
  }
}
